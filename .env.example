# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL with pgvector)
# Example: postgresql://username:password@localhost:5432/smartdocs_ai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartdocs_ai

# Authentication Secret
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10

# AI Provider Configuration
# Supported providers: "gemini" | "mock"
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here

# Model Identifiers
# Gemini Text Embedding: text-embedding-004 (768 dimensions)
AI_EMBEDDING_MODEL=text-embedding-004
AI_EMBEDDING_DIMENSION=768

# Gemini Generation Model: gemini-1.5-flash or gemini-1.5-pro
AI_GENERATION_MODEL=gemini-1.5-flash

# RAG Hyperparameters
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
